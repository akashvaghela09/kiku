<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown in the microphone permission prompt. Without this key macOS does not
	     ask at all: it terminates the process the moment CoreAudio is opened. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Kiku listens while you hold the dictation key and turns what you say into text. Audio is transcribed on this Mac and never leaves it.</string>
</dict>
</plist>
